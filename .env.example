# Copy to .env and fill in. Never commit .env.

# Weather data: free key from https://www.visualcrossing.com (required)
VISUAL_CROSSING_API_KEY=

# Language model, via Ollama. Pick ONE setup:
#   Local model:                  OLLAMA_MODEL=gemma4:12b   (or a smaller one, e.g. gemma4:e4b)
#   Cloud model via local Ollama: run `ollama signin`, then OLLAMA_MODEL=gemma4:cloud
#   Cloud without installing Ollama: OLLAMA_HOST=https://ollama.com, OLLAMA_MODEL=gemma4:31b,
#                                    and OLLAMA_API_KEY from https://ollama.com/settings/keys
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_API_KEY=
LLM_TIMEOUT_SECONDS=120

# How long to reuse a fetched forecast before calling the weather API again
CACHE_TTL_MINUTES=30
