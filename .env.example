# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: Docker's --env-file doesn't strip inline comments.

# Weather data: free key from https://www.visualcrossing.com (required)
VISUAL_CROSSING_API_KEY=

# Language model via Ollama. The active setup below is the default (local model).
# To switch, replace the three OLLAMA_ lines with one of these blocks:
#
#   Local model (default). Needs Ollama running and: ollama pull gemma4:12b
#     OLLAMA_HOST=http://localhost:11434
#     OLLAMA_MODEL=gemma4:12b
#     OLLAMA_API_KEY=
#
#   Cloud model via local Ollama. Needs: ollama signin, then ollama pull gemma4:cloud
#     OLLAMA_HOST=http://localhost:11434
#     OLLAMA_MODEL=gemma4:cloud
#     OLLAMA_API_KEY=
#
#   Ollama API directly, nothing installed. Key from https://ollama.com/settings/keys
#     OLLAMA_HOST=https://ollama.com
#     OLLAMA_MODEL=gemma4:31b
#     OLLAMA_API_KEY=your-key
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_API_KEY=

# Seconds to wait for an answer before showing the forecast data instead
LLM_TIMEOUT_SECONDS=120

# How long to reuse a fetched forecast before calling the weather API again
CACHE_TTL_MINUTES=30
