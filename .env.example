# Copy to .env and fill in. Never commit .env.

# Which LLM provider to use: "ollama" (local) or "api" (OpenAI-compatible free tier)
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=30

# Local model via Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# Hosted API (any OpenAI-compatible endpoint with a free tier)
LLM_API_BASE_URL=
LLM_API_MODEL=
LLM_API_KEY=

# Weather forecast cache lifetime
CACHE_TTL_MINUTES=30
